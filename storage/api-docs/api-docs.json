{
    "openapi": "3.0.0",
    "info": {
        "title": "API Інформаційної Системи «Супермаркет»",
        "description": "Документація версіонованого REST API (/api/v1) для лабораторної роботи №8: автентифікація Sanctum, авторизація Policies, API Resources.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000/api/v1",
            "description": "Локальний сервер розробки"
        }
    ],
    "paths": {
        "/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Реєстрація нового користувача API та отримання Bearer-токена",
                "operationId": "5d4fa5d5607ed675ba93907e1fc94534",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Олена Ткаченко"
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Користувача створено, повертає обʼєкт user та token",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "type": "object"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|AbCdEf..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Помилка валідації вхідних даних"
                    }
                }
            }
        },
        "/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Автентифікація користувача та отримання Bearer-токена",
                "operationId": "67d6d0fdd54fba132e1b6f55ca254183",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "password123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Успішний вхід (повертає об'єкт user та token)",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "user": {
                                            "type": "object"
                                        },
                                        "token": {
                                            "type": "string",
                                            "example": "1|AbCdEf..."
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Невірні облікові дані"
                    }
                }
            }
        },
        "/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Вихід: відкликати поточний токен доступу",
                "operationId": "28d48c13fca984400ac8de99f54ee13a",
                "responses": {
                    "200": {
                        "description": "Поточний токен видалено"
                    },
                    "401": {
                        "description": "Неавторизований доступ (відсутній токен)"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/categories": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Список категорій товарів (read-only)",
                "operationId": "289aa7aabb0be85ca7872c46dae173c4",
                "responses": {
                    "200": {
                        "description": "Успішне отримання списку"
                    }
                }
            }
        },
        "/discounts": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Список знижок, що застосовуються до замовлень (M:M, read-only)",
                "operationId": "afa1306445968126885245e62b39fb19",
                "responses": {
                    "200": {
                        "description": "Успішне отримання списку"
                    }
                }
            }
        },
        "/reviews": {
            "get": {
                "tags": [
                    "Catalog"
                ],
                "summary": "Останні схвалені відгуки про товари (read-only)",
                "operationId": "871e15b2aa0603484f32ad4b7b9a2e07",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успішне отримання списку"
                    }
                }
            }
        },
        "/products": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Отримати список товарів із пагінацією",
                "operationId": "645256586450da9881e2fe9ed1024521",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успішне отримання списку"
                    }
                }
            },
            "post": {
                "tags": [
                    "Products"
                ],
                "summary": "Створити новий товар (потрібен Bearer-токен)",
                "operationId": "5c64e84cc4ad3cc8d4f458a2164932fa",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "sku",
                                    "price",
                                    "category_id"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ноутбук Pro 16"
                                    },
                                    "sku": {
                                        "type": "string",
                                        "example": "NB-2026-01"
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 45999.99
                                    },
                                    "stock_qty": {
                                        "type": "integer",
                                        "example": 10
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Потужний ноутбук для роботи",
                                        "nullable": true
                                    },
                                    "is_active": {
                                        "type": "boolean",
                                        "example": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Товар успішно створено"
                    },
                    "401": {
                        "description": "Неавторизований доступ (відсутній токен)"
                    },
                    "422": {
                        "description": "Помилка валідації вхідних даних"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/products/{id}": {
            "get": {
                "tags": [
                    "Products"
                ],
                "summary": "Отримати один товар за ідентифікатором",
                "operationId": "1add5d6cf95e0730ed090c24b93c604f",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Успішне отримання запису"
                    },
                    "404": {
                        "description": "Запис не знайдено"
                    }
                }
            },
            "put": {
                "tags": [
                    "Products"
                ],
                "summary": "Оновити товар (лише власник запису)",
                "operationId": "add069f67ed897076cc45c09fb835f4b",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "sku",
                                    "price",
                                    "category_id"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "example": "Ноутбук Pro 16 (оновлено)"
                                    },
                                    "sku": {
                                        "type": "string",
                                        "example": "NB-2026-01"
                                    },
                                    "price": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 43999
                                    },
                                    "stock_qty": {
                                        "type": "integer",
                                        "example": 8
                                    },
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Товар успішно оновлено"
                    },
                    "401": {
                        "description": "Неавторизований доступ (відсутній токен)"
                    },
                    "403": {
                        "description": "Forbidden — користувач не є власником запису (ProductPolicy)"
                    },
                    "422": {
                        "description": "Помилка валідації вхідних даних"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Products"
                ],
                "summary": "Видалити товар (лише власник запису)",
                "operationId": "b589f291e75dfe26c40b68c1e289cd52",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "example": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Товар успішно видалено"
                    },
                    "401": {
                        "description": "Неавторизований доступ (відсутній токен)"
                    },
                    "403": {
                        "description": "Forbidden — користувач не є власником запису (ProductPolicy)"
                    },
                    "404": {
                        "description": "Запис не знайдено"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        }
    },
    "components": {
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "bearerFormat": "JWT",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Catalog",
            "description": "Catalog"
        },
        {
            "name": "Products",
            "description": "Products"
        }
    ]
}
@startuml
left to right direction
skinparam packageStyle rectangle
skinparam defaultFontName Arial

actor "Покупець" as Customer
actor "Касир" as Cashier
actor "Менеджер залу" as Manager
actor "Адміністратор" as Admin
actor "Платіжний термінал" as Terminal <<system>>

Cashier --|> Customer : узагальнення
Manager --|> Cashier : узагальнення
Admin --|> Manager : узагальнення

rectangle "Супермаркет\n(продаж товарів)" {
  usecase "Переглянути каталог" as UC_Browse
  usecase "Знайти товар" as UC_Search
  usecase "Знайти за відділом" as UC_SearchCat
  usecase "Знайти за назвою" as UC_SearchName
  usecase "Додати товар у кошик" as UC_Cart
  usecase "Оформити покупку" as UC_Order
  usecase "Розрахувати суму" as UC_Total
  usecase "Застосувати знижку" as UC_Discount
  usecase "Застосувати промокод" as UC_Promo
  usecase "Оплатити покупку" as UC_Pay
  usecase "Надіслати підтвердження" as UC_Notify
  usecase "Скасувати покупку" as UC_Cancel
  usecase "Обробити продаж" as UC_Process
  usecase "Керувати залишками" as UC_Stock
  usecase "Керувати каталогом" as UC_Catalog
  usecase "Керувати користувачами" as UC_Users
  usecase "Переглянути звіти" as UC_Reports
}

Customer --> UC_Browse
Customer --> UC_Search
Customer --> UC_Cart
Customer --> UC_Order
Cashier --> UC_Order
Cashier --> UC_Pay
Cashier --> UC_Discount
Manager --> UC_Process
Manager --> UC_Stock
Manager --> UC_Reports
Admin --> UC_Catalog
Admin --> UC_Users
Admin --> UC_Reports

UC_SearchCat --|> UC_Search
UC_SearchName --|> UC_Search

UC_Order ..> UC_Total : <<include>>
UC_Order ..> UC_Pay : <<include>>
UC_Order ..> UC_Notify : <<include>>
UC_Total ..> UC_Discount : <<include>>
UC_Cart ..> UC_Search : <<include>>

UC_Promo ..> UC_Discount : <<extend>>
UC_Cancel ..> UC_Order : <<extend>>
UC_Catalog ..> UC_Search : <<extend>>

UC_Pay --> Terminal
@enduml
